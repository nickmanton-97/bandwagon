<%= form_with model: @profile do |f| %>

  <div class="wizard">

    <div class="step-label" id="step-1">
      <div class="step-label-text">
        <h3>1</h3>
        <h3>Location</h3>
      </div>
    </div>

    <div class="step step-1 active">
      <div class="step-body-container">
        <p class="semibold">Where are you based?</h2>
        <div class="form-container">
          <%# Form field %>
          <div class="form-field">
            <p class="caption-black" id="black">Search below</p>
            <%= f.text_field :instrument, class: "field" %>
          </div>
      </div>
      </div>
        <div class="step-navigation">
          <p>Cancel</p>
          <button type="button" class="next">Next</button>
        </div>
    </div>

    <div class="step-label" id="step-2">
      <div class="step-label-text">
        <h3>2</h3>
        <h3>Music Bio</h3>
      </div>
    </div>

    <div class="step step-2">
      <h2>Your experience level</h2>
      <%= f.select :skill_level, ["Beginner", "Intermediate", "Pro"] %>
      <button type="button" class="next">Next</button>
    </div>

    <div class="step-label" id="step-3">
      <div class="step-label-text">
        <h3>3</h3>
        <h3>Commitment Level</h3>
      </div>
    </div>

    <div class="step step-3">
      <h2>Genres</h2>
      <%= f.text_field :genres %>
      <%= f.submit "Finish", class: "button" %>
    </div>

  </div>

<% end %>
