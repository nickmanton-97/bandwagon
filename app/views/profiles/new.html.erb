<%= form_with model: @profile do |f| %>

  <div class="wizard">

    <div class="step-label" id="step-1">
      <div class="step-label-text">
        <h3>1</h3>
        <h3>Location</h3>
      </div>
    </div>

    <div class="step step-1 active">
      <div class="step-body-container">
        <p class="semibold" id="step-heading">Where are you based?</h2>
        <div class="form-container">
          <%# Form field %>
          <div class="form-field" id="location-field">
            <p class="caption-black" id="black">Search below</p>

            <%= f.text_field :location,
                  class: "field location-input",
                  placeholder: "e.g. Fitzroy, Melbourne, VIC" %>

            <div id="location-suggestions" class="location-suggestions"></div>
          </div>
      </div>
      </div>
        <div class="step-navigation">
          <p>Cancel</p>
          <button type="button" class="next">Next</button>
        </div>
    </div>

    <div class="step-label" id="step-2">
      <div class="step-label-text">
        <h3>2</h3>
        <h3>Music Bio</h3>
      </div>
    </div>

    <div class="step step-2">
      <h2>Your experience level</h2>
      <%= f.select :skill_level, ["Beginner", "Intermediate", "Pro"] %>
      <button type="button" class="next">Next</button>
    </div>

    <div class="step-label" id="step-3">
      <div class="step-label-text">
        <h3>3</h3>
        <h3>Commitment Level</h3>
      </div>
    </div>

    <div class="step step-3">
      <div class="step-body-container">
        <p class="semibold" id="step-heading">How seriously are you pursuing music right now?</h2>
          <%# Form field %>
            <h2 class="commitment-option" id="true">Music is my main focus or income</h3>
            <h2 class="commitment-option" id="false">Music is a side passion or hobby</h3>
          </div>
       <div class="step-navigation">
          <p>Cancel</p>
          <button type="button" class="next"><%= f.submit "Finish", class: "button" %></button>
        </div>
  </div>

<% end %>

<script>
  document.addEventListener("DOMContentLoaded", () => {
    const input = document.querySelector(".location-input");
    const suggestionsContainer = document.getElementById("location-suggestions");

    if (!input || !suggestionsContainer) return;

    const locations = [
      "Fitzroy, Melbourne, VIC",
      "Collingwood, Melbourne, VIC",
      "Brunswick, Melbourne, VIC",
      "Geelong, VIC",
      "Torquay, VIC",
      "St Kilda, Melbourne, VIC",
      "South Yarra, Melbourne, VIC",
      "Carlton, Melbourne, VIC",
      "Richmond, Melbourne, VIC",
      "Prahran, Melbourne, VIC",
      "Footscray, Melbourne, VIC",
      "Hawthorn, Melbourne, VIC",
      "Camberwell, Melbourne, VIC",
      "Coburg, Melbourne, VIC",
      "Northcote, Melbourne, VIC",
      "Malvern, Melbourne, VIC",
      "Brighton, Melbourne, VIC",
      "Elwood, Melbourne, VIC",
      "Kew, Melbourne, VIC",
      "Balwyn, Melbourne, VIC",
      "Newtown, Sydney, NSW",
      "Surry Hills, Sydney, NSW",
      "Bondi, Sydney, NSW",
      "Manly, Sydney, NSW",
      "Parramatta, Sydney, NSW",
      "Paddington, Sydney, NSW",
      "Redfern, Sydney, NSW",
      "Glebe, Sydney, NSW",
      "Rose Bay, Sydney, NSW",
      "Coogee, Sydney, NSW",
      "Double Bay, Sydney, NSW",
      "Mosman, Sydney, NSW",
      "Chatswood, Sydney, NSW",
      "North Sydney, Sydney, NSW",
      "Woollahra, Sydney, NSW",
      "Neutral Bay, Sydney, NSW",
      "Potts Point, Sydney, NSW",
      "Fortitude Valley, Brisbane, QLD",
      "West End, Brisbane, QLD",
      "South Brisbane, Brisbane, QLD",
      "St Lucia, Brisbane, QLD",
      "Toowong, Brisbane, QLD",
      "Fremantle, Perth, WA",
      "Northbridge, Perth, WA",
      "Subiaco, Perth, WA",
      "Cottesloe, Perth, WA",
      "Scarborough, Perth, WA",
      "Battery Point, Hobart, TAS",
      "Sandy Bay, Hobart, TAS",
      "West Hobart, Hobart, TAS",
      "Moonah, Hobart, TAS",
      "Kingston, Hobart, TAS",
      "North Adelaide, Adelaide, SA",
      "Norwood, Adelaide, SA",
      "Glenelg, Adelaide, SA",
      "Prospect, Adelaide, SA",
      "Unley, Adelaide, SA",
      "Darwin City, Darwin, NT",
      "Parap, Darwin, NT",
      "Larrakeyah, Darwin, NT",
      "Casuarina, Darwin, NT",
      "Nightcliff, Darwin, NT",
      "Belconnen, Canberra, ACT",
      "Kingston, Canberra, ACT",
      "Civic, Canberra, ACT",
      "Manuka, Canberra, ACT",
      "Gungahlin, Canberra, ACT",
    ];

    function renderSuggestions(matches) {
      suggestionsContainer.innerHTML = "";

      if (matches.length === 0) return;

      matches.forEach(location => {
        const item = document.createElement("div");
        item.className = "location-suggestion-item";
        item.textContent = location;

        item.addEventListener("click", () => {
          input.value = location;
          suggestionsContainer.innerHTML = "";
        });

        suggestionsContainer.appendChild(item);
      });

      if (window.gsap && matches.length > 0) {
        window.gsap.fromTo(
          ".location-suggestion-item",
          { opacity: 0, y: 8 },
          { opacity: 1, y: 0, duration: 0.4, stagger: 0.08 }
        );
      }
    }

    input.addEventListener("input", (event) => {
      const query = event.target.value.trim().toLowerCase();

      if (!query) {
        suggestionsContainer.innerHTML = "";
        return;
      }

      const matches = locations
        .filter(location => location.toLowerCase().includes(query))
        .slice(0, 6);

      renderSuggestions(matches);
    });

// Commitment Options - moved inside DOMContentLoaded
    const commitmentOptions = document.querySelectorAll(".commitment-option");
    let selectedOption = null;

    commitmentOptions.forEach(option => {
      option.addEventListener("mouseenter", () => {
        if (!selectedOption) {
          commitmentOptions.forEach(opt => {
            if (opt !== option) {
              opt.style.opacity = "0.5";
            } else {
              opt.style.opacity = "1";
            }
          });
        }
      });

      option.addEventListener("mouseleave", () => {
        if (!selectedOption) {
          commitmentOptions.forEach(opt => {
            opt.style.opacity = "1";
          });
        }
      });

      option.addEventListener("click", () => {
        selectedOption = option;
        commitmentOptions.forEach(opt => {
          if (opt !== option) {
            opt.style.opacity = "0.5";
            opt.style.textDecoration = "none";
          } else {
            opt.style.opacity = "1";
            opt.style.textDecoration = "underline";
          }
        });
      });
    });
  });
</script>
