<div class="profile-card profile-colour-<%= profile.profile_colour || 'blue' %>" data-controller="profile-modal" data-action="click->profile-modal#open">
  <!-- Profile Image -->
  <div class="profile-card__image-wrapper">
    <% if profile.profile_picture.attached? %>
      <%= image_tag profile.profile_picture, class: "profile-card__image", alt: "#{profile.first_name}'s profile picture" %>
    <% else %>
      <div class="profile-card__image-placeholder">
        <span class="profile-card__initials"><%= profile.first_name&.first %><%= profile.last_name&.first %></span>
      </div>
    <% end %>
  </div>

  <!-- Profile Content -->
  <div class="profile-card__content">
    <h3 class="profile-card__name"><%= profile.first_name %> <%= profile.last_name %></h3>

    <!-- Instruments -->
    <% if profile.instruments.present? %>
      <div class="profile-card__instruments">
        <p class="caption-black">Instruments</p>
        <div class="profile-card__tags">
          <% profile.instruments.each do |instrument| %>
            <span class="profile-card__tag"><%= instrument %></span>
          <% end %>
        </div>
      </div>
    <% end %>

    <!-- Commitment -->
    <% if profile.commitment_level.present? %>
      <div class="profile-card__commitment">
        <p class="caption-black">Commitment</p>
        <p class="body-black"><%= profile.commitment_level.titleize %></p>
      </div>
    <% end %>
  </div>

  <!-- Actions -->
  <div class="profile-card__actions">
    <button type="button" class="profile-card__button" data-action="click->profile-modal#open" aria-label="View profile for <%= profile.first_name %>">
      View Profile
    </button>
  </div>
</div>
