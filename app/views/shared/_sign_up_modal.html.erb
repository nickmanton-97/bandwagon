<div id="sign-up-modal" class="modal">
  <div class="modal-content">
    <span class="close">&times;</span>

    <div class="form-wrapper">

      <div class="form-header">
        <h1>Welcome aboard</h1>
        <p>Create a free account.</p>
      </div>

      <%= form_for(User.new, url: user_registration_path) do |f| %>
        <div class="form-container">

          <div class="form-field">
            <p class="caption"><%= f.label :email %></p>
            <p class="semibold"><%= f.email_field :email, class: "field" %></p>
          </div>

          <div class="form-field">
            <p class="caption"><%= f.label :password %></p>
            <p class="semibold"><%= f.password_field :password, class: "field" %></p>
          </div>

          <div class="form-field">
            <p class="caption"><%= f.label :password_confirmation %></p>
            <p class="semibold"><%= f.password_field :password_confirmation, class: "field" %></p>
          </div>

          <div class="form-actions">
            <button class="button"><%= f.submit "Sign Up"%></div>
            <p class="caption">Already have an account? Log in</p>
          </div>

        </div>
      <% end %>

      <div class="form-banner-img">
        <img src="images/form/form_banner_02.png" alt="Sign Up Image">
      </div>
    </div>
  </div>
</div>
