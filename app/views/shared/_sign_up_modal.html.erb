<div id="sign-up-modal" class="modal">
  <div class="modal-content">
    <span class="close">&times;</span>
    <h2>Sign Up</h2>

    <%= form_for(User.new, url: registration_path(:user)) do |f| %>
      <div class="mb-4">
        <%= f.label :email %>
        <%= f.email_field :email, class: "w-full border p-2 rounded" %>
      </div>

      <div class="mb-4">
        <%= f.label :password %>
        <%= f.password_field :password, class: "w-full border p-2 rounded" %>
      </div>

      <div class="mb-4">
        <%= f.label :password_confirmation %>
        <%= f.password_field :password_confirmation, class: "w-full border p-2 rounded" %>
      </div>

      <div class="flex justify-end">
        <%= f.submit "Sign Up", class: "bg-orange-500 text-white px-4 py-2 rounded" %>
      </div>
    <% end %>
  </div>
</div>
