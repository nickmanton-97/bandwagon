<div id="log-in-modal" class="modal">
  <div class="modal-content">
    <span class="close">&times;</span>

    <div class="form-wrapper">
    <div class="form-header">
      <h1>Log in</h1>
      <p>Sign in to your account.</p>
    </div>

    <%= form_for(User.new, url: session_path(:user)) do |f| %>
        <div class="form-container">
          <div class="form-field">
            <p class="caption"><%= f.label :email %></p>
            <p class="semibold"><%= f.email_field :email, class: "field" %></p>
          </div>

          <div class="form-field">
            <p class="caption"><%= f.label :password %><p>
            <p class="semibold"><%= f.password_field :password, class: "field" %><p>
          </div>

          <div class="remember-me">
            <%= f.check_box :remember_me, class: "checkbox" %>
            <p class="caption"><%= f.label :remember_me, "Remember me", class: "caption" %></p>
          </div>

        <div class="form-actions">
        <button class="button">
          <%= f.submit "Log In"%>
        </button>
        <p class="caption" href="">Already have an account? Log in</p>
        </div>
        </div>
  </div>
   <div class="form-banner-img">
      <img src="images/form/form_banner_01.png" alt="Log In Image">
    </div>
  </div>
    <% end %>
  </div>
</div>
